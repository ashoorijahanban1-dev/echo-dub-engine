# =============================================================================
# RPIM Automation Pipeline v2 - Environment Configuration Template
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit real credentials or secrets to version control.
# =============================================================================

ENV=production
PORT=8000
STORAGE_DIR=storage

# Database URLs (PostgreSQL in production, or SQLite for local evaluation)
DISCOVERY_DB_URL=postgresql://coolify:CHANGE_ME_SECURE_PASSWORD@postgres:5432/rpim_discovery
PROCESSING_DB_URL=postgresql://coolify:CHANGE_ME_SECURE_PASSWORD@postgres:5432/rpim_processing
POSTGRES_USER=coolify
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Security & API Secrets (Must be at least 32 characters, randomly generated)
INTERNAL_API_SECRET=CHANGE_ME_MIN_32_CHARS_INTERNAL_SECRET
RELAY_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS_RELAY_AUTH_SECRET
CALLBACK_SIGNING_SECRET=CHANGE_ME_MIN_32_CHARS_CALLBACK_HMAC_SECRET

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://rpim.ir,https://admin.rpim.ir,https://n8n.rpim.ir

# HTTP Proxy (Optional: internal clients ignore ambient system proxies by default; enable only if required)
# PROXY_URL=http://proxy.example.com:8080


# AI / TTS Services
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
DEFAULT_VOICE_MALE=Puck
DEFAULT_VOICE_FEMALE=Aoede
EDGE_VOICE_MALE=fa-IR-FaridNeural
EDGE_VOICE_FEMALE=fa-IR-DilaraNeural

# Telegram Integration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_LOCAL_API_SERVER=

# Relay & Publisher
IRAN_RELAY_BASE_URL=https://rpim.ir
RPIM_API_BASE_URL=https://rpim.ir/api
RPIM_API_KEY=YOUR_RPIM_ADMIN_API_TOKEN
PUBLISH_DEFAULT_VISIBILITY=DRAFT
AUTO_PUBLISH_ON_COMPLETE=false

# Worker Safeguards
MIN_FREE_DISK_GB=10.0
MAX_ARCHIVE_EXTRACT_GB=30.0
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_INTERVAL_SECONDS=30
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_DUBBING_JOBS=1
