# ==============================================================================
# EchoDub AI Engine - Environment Configuration Template (.env)
# ==============================================================================

# 1. Google Gemini API (رایگان از Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Telegram CDN & MTProto Settings (از my.telegram.org و BotFather)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHANNEL_ID=@your_channel_or_channel_id

# 3. Model & Hardware Settings (Optimized for 8 CPU Cores)
WHISPER_MODEL_SIZE=large-v3
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8

# 4. Default Persian Voices (Microsoft Neural - 100% Free)
DEFAULT_PERSIAN_VOICE_MALE=fa-IR-FaridNeural
DEFAULT_PERSIAN_VOICE_FEMALE=fa-IR-DilaraNeural

# 5. Storage & Cleanup
AUTO_DELETE_TEMP_FILES=True
