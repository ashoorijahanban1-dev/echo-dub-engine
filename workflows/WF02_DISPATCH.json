        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RPIM-Internal-Secret",
              "value": "int_sec_af1716bf6979a5565127d7a856adffbfe4c62dd598d316fe"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"discovery_id\": \"{{ $json.id }}\",\n  \"url\": \"{{ $json.url }}\",\n  \"claim_token\": \"{{ $json.claim_token }}\"\n}",
        "options": {}
      },
      "id": "4",
      "name": "Validate Metadata & Enqueue Transfer/Extract",
      "type": "n8n-nodes-base.httpRequest",
